# Optional overrides for npm run start:production (debugging against the live backend).
# Copy to .env.production.local if needed. EAS uses the production environment instead.
EXPO_PUBLIC_API_ORIGIN=https://chat.roshanlama.com.np
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=

# Enable only after provisioning Firebase and Apple push credentials; rebuild native app.
EXPO_PUBLIC_NATIVE_PUSH_ENABLED=false
