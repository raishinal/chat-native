{
  "expo": {
    "name": "Relay",
    "slug": "chat-app-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chatappnative",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.relay.privatechat",
      "infoPlist": {
        "NSCameraUsageDescription": "Optional video in private calls.",
        "NSMicrophoneUsageDescription": "Microphone audio is required for calls."
      }
    },
    "android": {
      "permissions": ["android.permission.BLUETOOTH_CONNECT"],
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.relay.privatechat"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "apiRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos to share privately."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Relay to use your camera for optional video calls.",
          "microphonePermission": "Allow Relay to use your microphone for calls."
        }
      ],
      "./plugins/with-optional-camera",
      "./plugins/with-short-cmake-paths",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/message.wav"]
        }
      ],
      "@config-plugins/react-native-callkeep",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
