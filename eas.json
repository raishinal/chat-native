{
  "cli": {
    "version": ">=16.0.0"
  },
  "build": {
    "local": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_ENV": "local",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_API_ORIGIN": "http://localhost:8000"
      },
      "ios": {
        "env": {
          "EXPO_PUBLIC_API_ORIGIN": "http://localhost:8000"
        }
      },
      "android": {
        "env": {
          "EXPO_PUBLIC_NATIVE_PUSH_ENABLED": "true"
        }
      },
      "node": "24.12.0"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_ENV": "development",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_API_ORIGIN": "https://chat.roshanlama.com.np"
      },
      "android": {
        "env": {
          "EXPO_PUBLIC_NATIVE_PUSH_ENABLED": "true"
        }
      },
      "node": "24.12.0"
    },
    "staging": {
      "extends": "development",
      "developmentClient": false,
      "environment": "preview",
      "env": {
        "APP_ENV": "staging"
      }
    },
    "preview": {
      "extends": "staging",
      "developmentClient": false,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PUSHER_KEY": "c6d519b6adf701db85d4",
        "EXPO_PUBLIC_PUSHER_CLUSTER": "ap1"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "APP_ENV": "production",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_API_ORIGIN": "https://chat.roshanlama.com.np"
      },
      "android": {
        "env": {
          "EXPO_PUBLIC_NATIVE_PUSH_ENABLED": "false"
        }
      },
      "node": "24.12.0"
    }
  },
  "submit": {
    "production": {}
  }
}
