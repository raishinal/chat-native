    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-background-timer": "^2.4.1",
    "react-native-callkeep": "^4.6.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-incall-manager": "^4.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-voip-push-notification": "^3.3.3",
    "react-native-web": "~0.21.4",
    "react-native-webrtc": "^155.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node scripts/expo-environment.mjs local start --dev-client --clear --android",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node scripts/expo-environment.mjs local run:android",
    "ios": "node scripts/expo-environment.mjs local run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:connectivity": "node --experimental-strip-types --test scripts/call-connectivity.test.mjs",
    "types:check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "start:local": "node scripts/expo-environment.mjs local start --dev-client --clear --android",
    "start:dev": "node scripts/expo-environment.mjs development start --dev-client --clear --android",
    "start:staging": "node scripts/expo-environment.mjs staging start --dev-client --clear",
    "start:production": "node scripts/expo-environment.mjs production start --dev-client --clear",
    "android:dev": "node scripts/expo-environment.mjs development run:android",
    "ios:dev": "node scripts/expo-environment.mjs development run:ios",
    "config:local": "node scripts/expo-environment.mjs local --print-config",
    "config:dev": "node scripts/expo-environment.mjs development --print-config",
    "config:staging": "node scripts/expo-environment.mjs staging --print-config",
    "config:production": "node scripts/expo-environment.mjs production --print-config",
    "build:local": "npx eas-cli@latest build --profile local",
    "build:dev": "npx eas-cli@latest build --profile development",
    "build:staging": "npx eas-cli@latest build --profile staging",
    "build:preview": "npx eas-cli@latest build --profile preview",
    "build:production": "npx eas-cli@latest build --profile production",
    "start:android": "node scripts/expo-environment.mjs local start --dev-client --clear --android",
    "start:ios": "node scripts/expo-environment.mjs local start --dev-client --clear --ios",
    "start:server": "node scripts/expo-environment.mjs local start --dev-client --clear",
    "postinstall": "patch-package",
    "build:apk": "node scripts/build-apk.mjs"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-intent-launcher"
        ]
      }
    }
  }
}
